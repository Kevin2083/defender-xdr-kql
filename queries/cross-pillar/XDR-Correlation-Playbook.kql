// ============================================================================
// XDR CROSS-PILLAR CORRELATION — Kill Chain Playbooks
// Platform: Microsoft Defender XDR — Advanced Hunting
// Multi-table correlation across MDO, MDE, MDI, MDCA, Entra ID
// NOTE: Run each section as an independent query (each has its own let blocks)
//
// JOIN KEYS USED
// - Email/UrlClick <-> CloudAppEvents: recipient UPN == RawEventData.UserId (lowercased)
// - Entra sign-ins <-> CloudAppEvents: AccountObjectId
// - MDI (short host names) <-> MDE (FQDN): normalized to lowercase short hostname
// ============================================================================

// ── C1. BEC KILL CHAIN ───────────────────────────────────────────────────────
// Phish delivered → user clicks through → suspicious inbox rule within 48h
// Tables: EmailEvents, UrlClickEvents, CloudAppEvents

let lookback = 7d;
let PhishDelivered =
    EmailEvents
    | where Timestamp > ago(lookback)
    | where ThreatTypes has "Phish" or OriginalThreatTypes has "Phish"
    | where DeliveryAction == "Delivered"
    | project PhishTime = Timestamp, NetworkMessageId,
        User = tolower(RecipientEmailAddress), SenderFromAddress, Subject;
let ClickedLinks =
    UrlClickEvents
    | where Timestamp > ago(lookback)
    | where ActionType == "ClickAllowed" or IsClickedThrough == true
    | project ClickTime = Timestamp, NetworkMessageId, User = tolower(AccountUpn), Url;
let InboxRuleCreated =
    CloudAppEvents
    | where Timestamp > ago(lookback)
    | where ActionType in ("New-InboxRule","Set-InboxRule","UpdateInboxRules")
    | extend User = tolower(tostring(RawEventData.UserId)), Raw = tostring(RawEventData)
    | mv-apply Param = RawEventData.Parameters on (
        summarize RuleParams = make_bag(bag_pack(tostring(Param.Name), tostring(Param.Value))))
    | extend ForwardTo = strcat(tostring(RuleParams.ForwardTo), tostring(RuleParams.RedirectTo),
        tostring(RuleParams.ForwardAsAttachmentTo))
    | where ForwardTo has "@" or tostring(RuleParams.DeleteMessage) =~ "true"
        or tostring(RuleParams.MoveToFolder) has_any ("RSS","Deleted","Junk","Archive")
        or (ActionType == "UpdateInboxRules" and Raw has_any ("ForwardToRecipientsAction",
            "RedirectToRecipientsAction","DeleteAction","MoveToFolderAction"))
    | project RuleTime = Timestamp, User, RuleIP = IPAddress, ActionType, ForwardTo;
PhishDelivered
| join kind=inner ClickedLinks on NetworkMessageId, User
| where ClickTime between (PhishTime .. PhishTime + 2d)
| join kind=inner InboxRuleCreated on User
| where RuleTime between (ClickTime .. ClickTime + 2d)
| project PhishTime, ClickTime, RuleTime, User, SenderFromAddress, Subject, Url,
    ActionType, ForwardTo, RuleIP
| order by RuleTime desc

// ── C2. ACCOUNT TAKEOVER CHAIN ───────────────────────────────────────────────
// Risky successful sign-in → burst of cloud activity within 2 hours
// Tables: EntraIdSignInEvents, CloudAppEvents

let lookback = 14d;
let RiskySignIns =
    EntraIdSignInEvents
    | where Timestamp > ago(lookback)
    | where RiskLevelDuringSignIn >= 50 or RiskLevelAggregated >= 50 // medium or high
    | where ErrorCode == 0
    | project SignInTime = Timestamp, AccountObjectId, AccountUpn, SignInIP = IPAddress,
        Country, RiskLevelDuringSignIn, RiskLevelAggregated;
let CloudActivity =
    CloudAppEvents
    | where Timestamp > ago(lookback)
    | where isnotempty(AccountObjectId)
    | project ActTime = Timestamp, AccountObjectId, ActionType, Application, ActIP = IPAddress;
RiskySignIns
| join kind=inner CloudActivity on AccountObjectId
| where ActTime between (SignInTime .. SignInTime + 2h)
| summarize ActionCount = count(), Actions = make_set(ActionType, 25),
    Apps = make_set(Application, 10), ActivityIPs = make_set(ActIP, 10)
    by SignInTime, AccountUpn, SignInIP, Country, RiskLevelDuringSignIn, RiskLevelAggregated
| where ActionCount >= 10
| order by ActionCount desc

// ── C3. NTLM → SMB → REMOTE EXECUTION LATERAL MOVEMENT ──────────────────────
// NTLM logon to a host → SMB from source to that host → remote-exec child process on target
// Tables: IdentityLogonEvents, DeviceNetworkEvents, DeviceProcessEvents

let lookback = 24h;
let NTLMLogons =
    IdentityLogonEvents
    | where Timestamp > ago(lookback)
    | where Protocol == "NTLM" and ActionType == "LogonSuccess"
    | where AccountName !endswith "$"
    | extend Target = tolower(tostring(split(coalesce(DestinationDeviceName, TargetDeviceName), ".")[0]))
    | where isnotempty(Target)
    | project NTLMTime = Timestamp, AccountName, AccountDomain, SourceIP = IPAddress, Target;
let SMBConnections =
    DeviceNetworkEvents
    | where Timestamp > ago(lookback)
    | where RemotePort == 445 and ActionType == "ConnectionSuccess"
    | project SMBTime = Timestamp, SourceIP = LocalIP, SourceDevice = DeviceName,
        TargetIP = RemoteIP, SmbProcess = InitiatingProcessFileName;
let RemoteExec =
    DeviceProcessEvents
    | where Timestamp > ago(lookback)
    | where InitiatingProcessFileName in~ ("services.exe","wmiprvse.exe","wsmprovhost.exe",
        "psexesvc.exe","winrshost.exe","mmc.exe")
    | where FileName !in~ ("svchost.exe","conhost.exe","WmiPrvSE.exe","dllhost.exe")
    | extend Target = tolower(tostring(split(DeviceName, ".")[0]))
    | project ExecTime = Timestamp, Target, TargetDeviceId = DeviceId, FileName,
        ProcessCommandLine, ExecAccount = AccountName, ParentProcess = InitiatingProcessFileName;
NTLMLogons
| join kind=inner SMBConnections on SourceIP
| where SMBTime between ((NTLMTime - 5m) .. (NTLMTime + 5m))
| join kind=inner RemoteExec on Target
| where ExecTime between (NTLMTime .. NTLMTime + 15m)
| project NTLMTime, SMBTime, ExecTime, AccountName, AccountDomain, SourceIP, SourceDevice,
    Target, TargetDeviceId, ParentProcess, FileName, ProcessCommandLine
| order by NTLMTime desc

// ── C4. CREDENTIAL DUMP → AD RECON → LATERAL LOGONS ─────────────────────────
// LSASS access on a device → LDAP/SAMR burst from that device → same account logs on to 3+ hosts
// Tables: DeviceEvents, IdentityQueryEvents, IdentityLogonEvents

let lookback = 24h;
let CredentialDump =
    DeviceEvents
    | where Timestamp > ago(lookback)
    | where ActionType == "OpenProcessApiCall" and FileName =~ "lsass.exe"
    | where InitiatingProcessFileName !in~ ("MsMpEng.exe","MsSense.exe","SenseIR.exe","csrss.exe",
        "werfault.exe","WerFaultSecure.exe","svchost.exe","wininit.exe","taskmgr.exe")
    | extend Host = tolower(tostring(split(DeviceName, ".")[0]))
    | summarize DumpTime = min(Timestamp), DumpTools = make_set(InitiatingProcessFileName, 5)
        by Host, DeviceId, DeviceName;
let Recon =
    IdentityQueryEvents
    | where Timestamp > ago(lookback)
    | where ActionType contains "LDAP" or ActionType == "SAMR query"
    | extend Host = tolower(tostring(split(DeviceName, ".")[0]))
    | summarize ReconTime = min(Timestamp), QueryCount = count(),
        ReconAccounts = make_set(AccountName, 5) by Host
    | where QueryCount >= 20;
let LateralLogons =
    IdentityLogonEvents
    | where Timestamp > ago(lookback)
    | where ActionType == "LogonSuccess" and AccountName !endswith "$"
    | summarize FirstLogon = min(Timestamp), TargetHosts = dcount(DestinationDeviceName),
        Targets = make_set(DestinationDeviceName, 20) by AccountName;
CredentialDump
| join kind=inner Recon on Host
| where ReconTime > DumpTime
| mv-expand AccountName = ReconAccounts to typeof(string)
| join kind=inner LateralLogons on AccountName
| where FirstLogon > DumpTime and TargetHosts >= 3
| project DumpTime, ReconTime, FirstLogon, DeviceId, DeviceName, DumpTools, QueryCount,
    AccountName, TargetHosts, Targets
| order by DumpTime desc

// ── C5. INSIDER: BULK DOWNLOAD + EXTERNAL SHARE (same user, same day) ────────
// 50+ file downloads and an external/anonymous share by the same user within 24h
// Tables: CloudAppEvents

let lookback = 30d;
let BulkDownloads =
    CloudAppEvents
    | where Timestamp > ago(lookback)
    | where ActionType in ("FileDownloaded","FileSyncDownloadedFull")
    | summarize Downloads = count(), SizeBytes = sum(tolong(RawEventData.FileSizeBytes)),
        User = any(tostring(RawEventData.UserId))
        by AccountObjectId, Day = bin(Timestamp, 1d)
    | where Downloads >= 50;
let ExternalShares =
    CloudAppEvents
    | where Timestamp > ago(lookback)
    | where ActionType in ("SharingInvitationCreated","AnonymousLinkCreated","AddedToSecureLink")
    | extend TargetType = tostring(RawEventData.TargetUserOrGroupType)
    | where ActionType == "AnonymousLinkCreated" or TargetType =~ "Guest"
    | summarize Shares = count(), SharedItems = make_set(ObjectName, 10),
        ShareIPs = make_set(IPAddress, 5)
        by AccountObjectId, Day = bin(Timestamp, 1d);
BulkDownloads
| join kind=inner ExternalShares on AccountObjectId, Day
| project Day, User, AccountObjectId, Downloads, SizeMB = round(SizeBytes / 1048576.0, 1),
    Shares, SharedItems, ShareIPs
| order by Downloads desc

// ── C6. RANSOMWARE KILL CHAIN ────────────────────────────────────────────────
// Shadow-copy deletion → mass rename-to-new-extension on the same device within 1h,
// flagged if the device's user received a delivered phish in the prior 7 days
// Tables: EmailEvents, DeviceProcessEvents, DeviceFileEvents

let lookback = 24h;
let PhishRecipients =
    EmailEvents
    | where Timestamp > ago(7d)
    | where ThreatTypes has "Phish" and DeliveryAction == "Delivered"
    | distinct Recipient = tolower(RecipientEmailAddress);
let ShadowDelete =
    DeviceProcessEvents
    | where Timestamp > ago(lookback)
    | where ProcessCommandLine has_any ("vssadmin delete shadows","wmic shadowcopy delete",
        "Win32_ShadowCopy","bcdedit /set recoveryenabled no","wbadmin delete catalog")
    | project ShadowTime = Timestamp, DeviceId, DeviceName, ShadowAccount = AccountName,
        ShadowUpn = tolower(InitiatingProcessAccountUpn), ProcessCommandLine;
let MassEncrypt =
    DeviceFileEvents
    | where Timestamp > ago(lookback)
    | where ActionType == "FileRenamed"
    | extend NewExt = tolower(extract(@"\.([^.\\]+)$", 1, FileName)),
             OldExt = tolower(extract(@"\.([^.\\]+)$", 1, PreviousFileName))
    | where isnotempty(NewExt) and NewExt != OldExt
    | summarize FileCount = count(), NewExtensions = make_set(NewExt, 5),
        EncryptUpn = tolower(any(InitiatingProcessAccountUpn))
        by DeviceId, EncryptTime = bin(Timestamp, 5m)
    | where FileCount >= 100;
ShadowDelete
| join kind=inner MassEncrypt on DeviceId
| where EncryptTime between ((ShadowTime - 5m) .. (ShadowTime + 1h))
| extend RecentPhishRecipient = ShadowUpn in (PhishRecipients) or EncryptUpn in (PhishRecipients)
| project ShadowTime, EncryptTime, DeviceId, DeviceName, ShadowAccount, ProcessCommandLine,
    FileCount, NewExtensions, RecentPhishRecipient
| order by ShadowTime desc

// ── C7. MULTI-PRODUCT ALERT CONVERGENCE ON ONE ENTITY ────────────────────────
// Same user or device hit by high/medium alerts from 2+ Defender products in 24h
// (Advanced Hunting doesn't expose incident IDs, so this is how to
// surface cross-pillar activity that triage may be handling as separate alerts)
// Tables: AlertInfo, AlertEvidence

AlertInfo
| where Timestamp > ago(7d)
| where Severity in ("High","Medium")
| join kind=inner (
    AlertEvidence
    | where Timestamp > ago(7d)
    | where EntityType in ("User","Machine")
    | extend Entity = iff(EntityType == "User",
        tolower(coalesce(AccountUpn, AccountName)), tolower(coalesce(DeviceName, DeviceId)))
    | where isnotempty(Entity)
    | distinct AlertId, EntityType, Entity
) on AlertId
| summarize Products = dcount(ServiceSource), ProductList = make_set(ServiceSource, 10),
    Alerts = dcount(AlertId), Titles = make_set(Title, 15), Severities = make_set(Severity),
    FirstAlert = min(Timestamp), LastAlert = max(Timestamp)
    by EntityType, Entity, Window = bin(Timestamp, 1d)
| where Products >= 2
| order by Products desc, Alerts desc
