// ============================================================================
// MDCA CLOUD APPS — OAuth, Exfiltration, Shadow IT, Admin Abuse
// Platform: Microsoft Defender XDR — Advanced Hunting
// Tables: CloudAppEvents, AADSignInEventsBeta
// ============================================================================

// ── 1. OAUTH APP ABUSE ───────────────────────────────────────────────────────

// 1.1 High-privilege OAuth app consent events
CloudAppEvents
| where Timestamp > ago(30d)
| where ActionType == "Consent to application"
| extend ConsentDetails = parse_json(RawEventData)
| extend Scopes = tostring(ConsentDetails.OAuthApplicationGrantScope)
| where Scopes has_any ("Mail.ReadWrite","Files.ReadWrite.All","Directory.ReadWrite.All",
    "full_access_as_user","User.ReadWrite.All","EWS.AccessAsUser.All")
| project Timestamp, AccountUpn, Application, Scopes, IPAddress, CountryCode
| order by Timestamp desc

// ──────────────────────────────────────────────────────────────────────────────

// 1.2 OAuth app granted tenant-wide admin consent (service principal added)
CloudAppEvents
| where Timestamp > ago(30d)
| where ActionType == "Add service principal"
| extend Details = parse_json(RawEventData)
| project Timestamp, AccountUpn, Application, IPAddress,
    DisplayName   = tostring(Details.ObjectId),
    AdditionalFields

// ──────────────────────────────────────────────────────────────────────────────

// 1.3 Unusual OAuth app token refresh from new location
CloudAppEvents
| where Timestamp > ago(7d)
| where ActionType == "UserLoggedIn"
| where Application !in~ ("Microsoft Teams","Microsoft SharePoint Online",
    "Office 365 Exchange Online","Microsoft Graph")
| summarize Logons = count(), Countries = dcount(CountryCode),
    IPs = dcount(IPAddress), LastSeen = max(Timestamp)
    by Application, AccountUpn
| where Countries >= 3 or Logons >= 50
| order by Logons desc

// ── 2. DATA EXFILTRATION ─────────────────────────────────────────────────────

// 2.1 Bulk SharePoint/OneDrive download (100+ files or 100MB in 1 hour)
CloudAppEvents
| where Timestamp > ago(7d)
| where ActionType in ("FileDownloaded","FileSyncDownloadedFull")
| summarize Downloads = count(),
    SizeBytes = sum(tolong(parse_json(RawEventData).FileSizeBytes))
    by AccountUpn, bin(Timestamp, 1h)
| where Downloads >= 100 or SizeBytes >= 104857600
| order by Downloads desc

// ──────────────────────────────────────────────────────────────────────────────

// 2.2 External file sharing outside tenant domain
// Replace yourdomain.com with your domain
CloudAppEvents
| where Timestamp > ago(7d)
| where ActionType in ("SharingInvitationCreated","AnonymousLinkCreated","SharingSet")
| extend SharingDetails = parse_json(RawEventData)
| extend SharedWith = tostring(SharingDetails.TargetUserOrGroupEmailAddress)
| where SharedWith !endswith "yourdomain.com" and isnotempty(SharedWith) // customize
| project Timestamp, AccountUpn, ActionType, SharedWith, IPAddress
| order by Timestamp desc

// ──────────────────────────────────────────────────────────────────────────────

// 2.3 Personal cloud storage uploads (Dropbox / Google Drive / Box)
CloudAppEvents
| where Timestamp > ago(7d)
| where Application in~ ("Dropbox","Google Drive","Box","WeTransfer","OneDrive Personal")
| where ActionType in ("FileUploaded","FileCreated","Upload")
| summarize UploadCount = count() by AccountUpn, Application, bin(Timestamp, 1h)
| where UploadCount >= 10
| order by UploadCount desc

// ── 3. IMPOSSIBLE TRAVEL / SUSPICIOUS LOGON ──────────────────────────────────

// 3.1 Impossible travel — 3+ countries in 6-hour window
CloudAppEvents
| where Timestamp > ago(7d)
| where ActionType == "UserLoggedIn"
| summarize Countries = dcount(CountryCode), LogonCount = count(),
    CountryList = make_set(CountryCode, 10),
    IPList      = make_set(IPAddress, 10)
    by AccountUpn, bin(Timestamp, 6h)
| where Countries >= 3
| order by Countries desc

// ──────────────────────────────────────────────────────────────────────────────

// 3.2 Logon from anonymous proxy / Tor exit node
CloudAppEvents
| where Timestamp > ago(7d)
| where ActionType == "UserLoggedIn"
| where IPTags has_any ("Anonymous proxy","Tor","Botnet")
| project Timestamp, AccountUpn, Application, IPAddress, CountryCode, IPTags

// ──────────────────────────────────────────────────────────────────────────────

// 3.3 First-ever access to a cloud app by user (last 7 days, <=3 accesses)
CloudAppEvents
| where Timestamp > ago(90d)
| summarize FirstAccess = min(Timestamp), AccessCount = count()
    by AccountUpn, Application
| where FirstAccess > ago(7d) and AccessCount <= 3
| order by FirstAccess desc

// ── 4. ADMIN ACTIVITY AUDITING ───────────────────────────────────────────────

// 4.1 Global admin activity outside business hours
CloudAppEvents
| where Timestamp > ago(30d)
| where ActionType has_any ("Add member to role","Remove member from role",
    "Set domain authentication","Set company information")
| where hourofday(Timestamp) !between (7 .. 18)
    or dayofweek(Timestamp) in (0d, 6d)
| project Timestamp, AccountUpn, ActionType, Application, IPAddress, CountryCode

// ──────────────────────────────────────────────────────────────────────────────

// 4.2 Bulk user account operations (10+ operations in 1 hour)
CloudAppEvents
| where Timestamp > ago(7d)
| where ActionType in ("Delete user","Disable account","Reset user password",
    "Remove member from group")
| summarize OperationCount = count(),
    AffectedUsers = make_set(tostring(parse_json(RawEventData).TargetResources), 20)
    by AccountUpn, ActionType, bin(Timestamp, 1h)
| where OperationCount >= 10
| order by OperationCount desc

// ──────────────────────────────────────────────────────────────────────────────

// 4.3 Email/message deletion anomalies (mail purge, bulk delete)
CloudAppEvents
| where Timestamp > ago(14d)
| where Application == "Microsoft Exchange Online"
| where ActionType in ("Delete messages","Move messages to Deleted Items folder",
    "Permanently delete messages","Move messages to folder")
| summarize DeleteCount = count() by AccountUpn, ActionType, bin(Timestamp, 1h)
| where DeleteCount >= 50
| order by DeleteCount desc
